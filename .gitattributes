# Default behavior: auto-detect text files and normalize to LF
* text=auto eol=lf

# Windows-specific scripts require CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must strictly be LF (prevents WSL/Docker crashes)
*.sh text eol=lf
.envrc text eol=lf

# Binary documents and images - do not modify line endings
*.pdf binary
*.pptx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary