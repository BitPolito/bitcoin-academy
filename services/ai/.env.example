# -----------------------------------------------------------------------
# Bitcoin Academy — Backend environment variables
# Copy this file to .env and fill in the values before starting.
# -----------------------------------------------------------------------

# --- Task queue (required for async ingestion) -------------------------
REDIS_URL=redis://localhost:6379/0

# --- Database (required) -----------------------------------------------
# For local dev without PostgreSQL/Docker, SQLite works out of the box:
DATABASE_URL=sqlite:///./bitcoin_academy.db
# For PostgreSQL (recommended for production and team dev):
# DATABASE_URL=postgresql://bitcoin_academy:bitcoin_academy@localhost:5432/bitcoin_academy

# --- Auth / JWT (required) ---------------------------------------------
SECRET_KEY=change-me-must-be-at-least-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Runtime -----------------------------------------------------------
ENVIRONMENT=development          # development | production
API_PORT=8000

# --- CORS (required in production) -------------------------------------
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000

# --- ALLOWED_HOSTS (production only) -----------------------------------
# ALLOWED_HOSTS=academy.example.com

# --- AI / LLM (optional — system works without it; generation actions return fallback text) ---
OPENAI_API_KEY=

# --- ChromaDB (local vector store path) ----------------------------------------
# MUST be an absolute path. A relative path causes read/write to diverge when
# uvicorn is started from a directory other than services/ai/.
# Example (adjust to your machine):
CHROMA_DB_PATH=/absolute/path/to/bitcoin-academy/services/ai/chroma_db

# --- Retrieval tuning ----------------------------------------------------------
RAG_TOP_K=10
# HyDE (Hypothetical Document Embeddings) — improves recall on technical queries.
# Adds ~400 ms per query via an extra /generate call. Disable with RAG_HYDE=false.
RAG_HYDE=true

# --- LLM generation timeout (seconds) -----------------------------------------
LLM_TIMEOUT_SECONDS=30

# --- Debug mode (enables /api/debug/* endpoints — never enable in production) ---
DEBUG_MODE=false

# --- QVAC integration (optional — bypassed when QVAC_SERVICE_URL is unset) ------
QVAC_SERVICE_URL=http://localhost:3001

# Directory where pipeline.py writes JSONL files for QVAC to read
QVAC_INGEST_DIR=./qvac_ingest

# Timeout (seconds) for the QVAC /ingest HTTP call.
# Large PDFs (400+ pages) need ~3-5 min for GTE_LARGE_FP16 embedding.
QVAC_INGEST_TIMEOUT=300

# Set to true to skip in-process fastembed + ChromaDB write during ingestion.
# QVAC becomes the sole index; ChromaDB fallback still works at query time
# for documents already indexed before this flag was enabled.
SKIP_CHROMA_INDEX=true

# File upload storage
UPLOADS_DIR=./uploads

# ChromaDB collection name — must match exactly across pipeline.py and retrieval_service.py
CHROMA_COLLECTION_NAME=bitpolito_course

# Max evidence chunks returned to the study endpoint
RAG_MAX_EVIDENCE=6
