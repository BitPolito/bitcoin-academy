# -----------------------------------------------------------------------
# Bitcoin Academy — Backend environment variables
# Copy this file to .env and fill in the values before starting.
# -----------------------------------------------------------------------

# --- Task queue (required for async ingestion) -------------------------
# Uncomment when Redis is running (required for document uploads and semantic cache).
# In dev without Redis, leave this commented — the backend starts in SQLite/in-memory mode.
# REDIS_URL=redis://localhost:6379/0

# --- Database (required) -----------------------------------------------
# For local dev without PostgreSQL/Docker, SQLite works out of the box:
DATABASE_URL=sqlite:///./bitcoin_academy.db
# For PostgreSQL (recommended for production and team dev):
# DATABASE_URL=postgresql://bitcoin_academy:bitcoin_academy@localhost:5432/bitcoin_academy

# --- Auth / JWT (required) ---------------------------------------------
SECRET_KEY=change-me-must-be-at-least-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Runtime -----------------------------------------------------------
ENVIRONMENT=development          # development | production
API_PORT=8000

# --- CORS (required in production) -------------------------------------
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000

# --- ALLOWED_HOSTS (production only) -----------------------------------
# ALLOWED_HOSTS=academy.example.com

# --- QVAC integration ---------------------------------------------------------
QVAC_SERVICE_URL=http://localhost:3001

# Directory where pipeline.py writes JSONL files for QVAC to read
QVAC_INGEST_DIR=./qvac_ingest

# Timeout (seconds) for the QVAC /ingest HTTP call.
# Large PDFs (400+ pages) need ~3-5 min for GTE-Large FP16 embedding.
QVAC_INGEST_TIMEOUT=300

# Set to true to skip ChromaDB write during ingestion (QVAC becomes the sole index).
SKIP_CHROMA_INDEX=true

# --- Retrieval tuning ---------------------------------------------------------
# Chunks passed to the LLM after reranking
RAG_TOP_K=5
# Candidates fetched from dense + sparse retrieval pool before reranking
RAG_RETRIEVE_K=20
# Approximate token budget for assembled context blocks (words × 1.3)
RAG_MAX_CONTEXT_TOKENS=6000
# HyDE (Hypothetical Document Embeddings) — improves recall on technical queries
RAG_HYDE=true
# Context compression — trims each passage to query-relevant sentences before LLM
RAG_COMPRESS_CONTEXT=true
# Contextual chunk enrichment — AI-generated prefix prepended at ingest time
RAG_CONTEXTUAL_CHUNKS=false

# --- Semantic cache (requires Redis) ------------------------------------------
# Set to false to disable the semantic cache entirely
RAG_SEMANTIC_CACHE=true
# Cosine similarity threshold for a cache hit (0–1)
RAG_CACHE_THRESHOLD=0.92
# Cache entry lifetime in seconds (default 24 h)
RAG_CACHE_TTL_SECONDS=86400

# --- Document parsing ----------------------------------------------------------
# File upload storage
UPLOADS_DIR=./uploads
# Set to true to use Docling for PDF parsing instead of pymupdf4llm
USE_DOCLING=false
# ChromaDB path — used only when SKIP_CHROMA_INDEX=false
CHROMA_DB_PATH=/absolute/path/to/bitcoin-academy/services/ai/chroma_db
CHROMA_COLLECTION_NAME=bitpolito_course

# --- Max evidence chunks returned to the study endpoint -----------------------
RAG_MAX_EVIDENCE=6

# --- Debug mode (enables /api/debug/* endpoints — never enable in production) ---
DEBUG_MODE=false
